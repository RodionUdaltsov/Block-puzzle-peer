{
  "name": "block-puzzle-server",
  "version": "3.10.12",
  "description": "Block Puzzle \u2014 PostgreSQL-only player progress",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/bundle-css.js && node scripts/bundle-client.js",
    "build:dev": "node scripts/bundle-css.js --no-minify && node scripts/bundle-client.js --no-minify",
    "build:watch": "node scripts/bundle-client.js --watch",
    "build:css": "node scripts/bundle-css.js",
    "start": "node scripts/bundle-css.js && node scripts/bundle-client.js && node server.js",
    "start:postgres": "node scripts/bundle-css.js && node scripts/bundle-client.js && BP_STORE=postgres node server.js",
    "migrate:postgres": "node scripts/migrate-file-to-postgres.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
