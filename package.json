{
  "name": "block-puzzle-server",
  "version": "3.13.2",
  "description": "Block Puzzle \u2014 PostgreSQL-only player progress",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/bundle-html.js && node scripts/bundle-css.js && node scripts/bundle-client.js",
    "build:dev": "node scripts/bundle-html.js && node scripts/bundle-css.js --no-minify && node scripts/bundle-client.js --no-minify",
    "build:watch": "node scripts/bundle-client.js --watch",
    "build:css": "node scripts/bundle-css.js",
    "start": "npm run build && node server.js",
    "start:postgres": "npm run build && BP_STORE=postgres node server.js",
    "migrate:postgres": "node scripts/migrate-file-to-postgres.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "build:html": "node scripts/bundle-html.js",
    "test:pg": "node --test --test-concurrency=4 test/postgres-concurrency.e2e.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
